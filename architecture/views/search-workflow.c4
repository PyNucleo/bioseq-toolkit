views {
  view searchWorkflow of bioseqToolkit.searchPipeline {
    title 'Search Workflow'

    include owner
    include bioseqToolkit.cli
    include bioseqToolkit.searchPipeline
    include bioseqToolkit.databaseUtils
    include bioseqToolkit.sequenceDatabase
    include bioseqToolkit.fastaIo
    include bioseqToolkit.kmerSearch
    include bioseqToolkit.kmerIndex
    include bioseqToolkit.similarityRank
    include bioseqToolkit.refinement
    include bioseqToolkit.sw
    include bioseqToolkit.tests

    autoLayout LeftRight
  }
}
