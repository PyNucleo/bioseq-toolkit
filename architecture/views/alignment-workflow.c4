views {
  view alignmentWorkflow of bioseqToolkit {
    title 'Alignment Workflow'

    include owner
    include bioseqToolkit.cli
    include bioseqToolkit.nw
    include bioseqToolkit.sw
    include bioseqToolkit.scoring
    include bioseqToolkit.matrices
    include bioseqToolkit.alignmentStats
    include bioseqToolkit.refinement
    include bioseqToolkit.tests
    include biopython

    autoLayout LeftRight
  }
}
